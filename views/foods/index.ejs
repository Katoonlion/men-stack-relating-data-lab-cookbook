<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Pantry</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>

    <h1>Welcome to my Pantry</h1>
    <!-- <pre><%= JSON.stringify(user, null, 2) %></pre> -->
    <% if (pantry && pantry.length > 0) { %>
        <ul>
            <% pantry.forEach(food => { %>
                <li>
                    <%= food.name %>
                    <!-- Edit -->
                    <a href="/users/<%= userId %>/foods/<%= food._id %>/edit">Edit</a>
                    
                    <!-- Delete -->
                    <form
                        action="/users/<%= userId %>/foods/<%= food._id %>?_method=DELETE"
                        method="POST"
                        style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this item?');"
                    >
                    
                        <button type="submit">Delete</button>
                    
                    </form>
                </li>
            <% }) %>
        </ul>
    
    <% } else { %>
        <p>There are no items in this pantry.</p>
  
    <% } %>

    <a href="/users/<%= userId %>/foods/new">Add New Item</a>

  </body>
</html>
