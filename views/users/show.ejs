<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profileUser.username %>'s Pantry</title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>

    <h1><%= profileUser.username %>'s Pantry</h1>

    <% if (pantry && pantry.length > 0) { %>
        <ul>
            <% pantry.forEach((food) => { %>
                <li>
                    <%= food.name %>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>There are no items in this pantry.</p>
    <% } %>

    <p><a href="/users">← Back to Community</a></p>
    
</body>
</html>