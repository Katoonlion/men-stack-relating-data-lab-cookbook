<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profileUser.username %>'s Recipes</title>

</head>
<body>
    <%- include('../partials/_navbar.ejs') %>

    <h1>Recipes by <%= profileUser.username %></h1>

    <% if (recipes && recipes.length > 0) { %>
        <ul>
            <% recipes.forEach((r) => { %>
                <li>
                    <a href="/recipes/<%= r._id %>"><%= r.name %></a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>This user has no recipes yet.</p>
    <% } %>

    <p><a href="/users">← Back to Community</a></p>
    
</body>
</html>